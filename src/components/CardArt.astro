---
/**
 * CardArt — a bespoke, CSS/SVG-drawn scene for each featured card.
 *
 * Every card used to reuse the same crop of the hero photograph, which made
 * three different projects read as one. Each variant below is drawn from the
 * subject of its own card, in the site's night-sky palette.
 */
export type CardArtVariant = 'notes' | 'library' | 'reading';

interface Props {
  variant: CardArtVariant;
}

const { variant } = Astro.props;
// Gradient/mask ids must be unique — three of these render on the same page.
const uid = `art-${variant}`;
---

{variant === 'notes' && (
  <svg
    class="card-art card-art--notes"
    viewBox="0 0 320 150"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0.35" y2="1">
        <stop offset="0" stop-color="#101748" />
        <stop offset="0.58" stop-color="#1b2270" />
        <stop offset="1" stop-color="#2b2f8d" />
      </linearGradient>
      <radialGradient id={`${uid}-glow`}>
        <stop offset="0" stop-color="#efecff" stop-opacity="0.5" />
        <stop offset="1" stop-color="#efecff" stop-opacity="0" />
      </radialGradient>
      <mask id={`${uid}-crescent`}>
        <rect width="320" height="150" fill="#000" />
        <circle cx="243" cy="47" r="23" fill="#fff" />
        <circle cx="233" cy="41" r="21" fill="#000" />
      </mask>
    </defs>

    <rect width="320" height="150" fill={`url(#${uid}-sky)`} />
    <circle cx="243" cy="47" r="52" fill={`url(#${uid}-glow)`} />
    <rect width="320" height="150" fill="#f4f1ff" mask={`url(#${uid}-crescent)`} />

    {/* the page the notes are written on, folding into the horizon */}
    <g stroke="#b9beff" stroke-linecap="round" fill="none">
      <path d="M26 104h148" stroke-opacity="0.3" stroke-width="1.6" />
      <path d="M26 118h196" stroke-opacity="0.22" stroke-width="1.6" />
      <path d="M26 132h112" stroke-opacity="0.14" stroke-width="1.6" />
    </g>

    <g fill="#e5e3ff">
      <circle cx="58" cy="34" r="1.5" opacity="0.9" />
      <circle cx="112" cy="58" r="1.1" opacity="0.55" />
      <circle cx="164" cy="28" r="1.3" opacity="0.7" />
      <circle cx="292" cy="96" r="1.1" opacity="0.5" />
    </g>
  </svg>
)}

{variant === 'library' && (
  <svg
    class="card-art card-art--library"
    viewBox="0 0 320 150"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id={`${uid}-sky`} x1="0.1" y1="0" x2="0.9" y2="1">
        <stop offset="0" stop-color="#171b63" />
        <stop offset="0.6" stop-color="#2a2091" />
        <stop offset="1" stop-color="#3d2b9e" />
      </linearGradient>
      <linearGradient id={`${uid}-shelf`} x1="0" y1="0" x2="1" y2="0">
        <stop offset="0" stop-color="#9d95ff" stop-opacity="0.08" />
        <stop offset="0.5" stop-color="#cfc9ff" stop-opacity="0.65" />
        <stop offset="1" stop-color="#9d95ff" stop-opacity="0.08" />
      </linearGradient>
      <radialGradient id={`${uid}-core`}>
        <stop offset="0" stop-color="#fff" stop-opacity="0.9" />
        <stop offset="1" stop-color="#b9aeff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="320" height="150" fill={`url(#${uid}-sky)`} />

    {/* an open card catalogue, fanned out as arcs of orbit */}
    <g fill="none" stroke={`url(#${uid}-shelf)`} stroke-linecap="round">
      <path d="M44 146a116 116 0 0 1 232 0" stroke-width="1.5" opacity="0.55" />
      <path d="M68 146a92 92 0 0 1 184 0" stroke-width="1.5" opacity="0.75" />
      <path d="M94 146a66 66 0 0 1 132 0" stroke-width="2" opacity="1" />
      <path d="M120 146a40 40 0 0 1 80 0" stroke-width="1.5" opacity="0.6" />
    </g>

    <circle cx="160" cy="146" r="34" fill={`url(#${uid}-core)`} />

    {/* files resting on the lit shelf */}
    <g fill="#efecff">
      <circle cx="122" cy="106" r="2.4" opacity="0.95" />
      <circle cx="160" cy="82" r="2.8" opacity="1" />
      <circle cx="198" cy="106" r="2.4" opacity="0.95" />
      <circle cx="96" cy="130" r="1.8" opacity="0.6" />
      <circle cx="224" cy="130" r="1.8" opacity="0.6" />
    </g>

    <g fill="#d8d3ff" opacity="0.5">
      <circle cx="52" cy="36" r="1.3" />
      <circle cx="268" cy="30" r="1.5" />
      <circle cx="292" cy="66" r="1.1" />
    </g>
  </svg>
)}

{variant === 'reading' && (
  <svg
    class="card-art card-art--reading"
    viewBox="0 0 320 150"
    preserveAspectRatio="xMidYMid slice"
    aria-hidden="true"
    focusable="false"
  >
    <defs>
      <linearGradient id={`${uid}-sky`} x1="0" y1="0" x2="0.6" y2="1">
        <stop offset="0" stop-color="#1a1250" />
        <stop offset="0.55" stop-color="#331c74" />
        <stop offset="1" stop-color="#4a2276" />
      </linearGradient>
      <radialGradient id={`${uid}-node`}>
        <stop offset="0" stop-color="#fff" stop-opacity="0.95" />
        <stop offset="1" stop-color="#f0b9ff" stop-opacity="0" />
      </radialGradient>
    </defs>

    <rect width="320" height="150" fill={`url(#${uid}-sky)`} />

    {/* one paper, and everything it cites */}
    <g stroke="#e2c6ff" fill="none" stroke-linecap="round">
      <path d="M132 76 62 40" stroke-opacity="0.3" stroke-width="1.2" />
      <path d="M132 76 54 96" stroke-opacity="0.22" stroke-width="1.2" />
      <path d="M132 76 96 128" stroke-opacity="0.26" stroke-width="1.2" />
      <path d="M132 76 216 44" stroke-opacity="0.55" stroke-width="1.4" />
      <path d="M132 76 244 92" stroke-opacity="0.34" stroke-width="1.2" />
      <path d="M132 76 190 124" stroke-opacity="0.24" stroke-width="1.2" />
    </g>

    <circle cx="132" cy="76" r="30" fill={`url(#${uid}-node)`} />
    <circle cx="132" cy="76" r="5" fill="#fff" />

    <g fill="#f4e6ff">
      <circle cx="62" cy="40" r="2.6" opacity="0.75" />
      <circle cx="54" cy="96" r="2.2" opacity="0.6" />
      <circle cx="96" cy="128" r="2.2" opacity="0.65" />
      <circle cx="216" cy="44" r="3.4" opacity="1" />
      <circle cx="244" cy="92" r="2.4" opacity="0.7" />
      <circle cx="190" cy="124" r="2" opacity="0.55" />
    </g>

    <g fill="#efdcff" opacity="0.45">
      <circle cx="284" cy="26" r="1.3" />
      <circle cx="300" cy="118" r="1.1" />
      <circle cx="30" cy="20" r="1.2" />
    </g>
  </svg>
)}
